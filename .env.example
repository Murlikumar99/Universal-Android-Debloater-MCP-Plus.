# Server & Security Configuration
PORT=3000
NODE_ENV=development
SESSION_SECRET=change-this-in-production-vercel-env-secret-key-64-chars
ALLOWED_ORIGINS=http://localhost:3000

# ADB & MCP Server Configuration
ADB_PATH=
ADB_MOCK=1
ADB_TIMEOUT_MS=15000
ADB_E2E=0
ADB_E2E_DESTRUCTIVE=0
UAD_DATA_DIR=.uad-mcp-data
MCP_HTTP_ENABLED=false
MCP_HTTP_PORT=3100
MCP_HTTP_TOKEN=

# Optional Distributed Rate Limiting (Upstash Redis for Vercel)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
